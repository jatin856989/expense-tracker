# Get this from the Neon dashboard (neon.tech), or from Vercel's Storage
# tab if you provisioned the database from there. See DEPLOYMENT.md.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# --- Login wall (see AUTH_SETUP.md for how to generate these) ---
AUTH_USERNAME="your-chosen-username"
AUTH_PASSWORD_HASH="base64-encoded-bcrypt-hash-goes-here"
AUTH_SECRET="long-random-string-goes-here"
